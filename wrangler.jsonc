{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "burionstudio-web",
  "main": "worker.js",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/privacy",
      "/terms",
      "/privacy.html",
      "/terms.html"
    ]
  }
}
